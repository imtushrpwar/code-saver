<!DOCTYPE html>
<html>
<head>
  <title>Code App</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    html, body {
  margin: 0;
  padding: 0;
  background: black;
}

    /* NAVBAR WRAPPER */
    .premium-nav {
  position: absolute;
  top: 20px;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 1000;
}
    /* MAIN CONTAINER */
    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;

      width: 85%;
      max-width: 1000px;

      padding: 10px 20px;

   background-color: rgba(0, 0, 0, 0.4);
      border-radius: 50px;

      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    /* LEFT LOGO */
    .nav-logo {
      background: #2c2c2c;
      border-radius: 50%;
      padding: 10px 14px;
      color: white;
      font-size: 14px;
    }

    /* LINKS */
    .nav-links {
      display: flex;
      gap: 25px;
    }

    .nav-links a {
      color: #ccc;
      text-decoration: none;
      font-size: 14px;
      transition: 0.2s;
    }

    .nav-links a:hover {
      color: white;
    }

    /* RIGHT SIDE */
    .nav-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* LOGIN BUTTON */
    .nav-btn {
      background: white;
      color: black;
      padding: 6px 16px;
      border-radius: 30px;
      text-decoration: none;
      font-size: 13px;
      transition: 0.2s;
    }

    .nav-btn:hover {
      background: #ddd;
    }

    /* EMAIL BADGE */
    .nav-user {
      background: #e5e5e5;
      color: #111;
      padding: 6px 14px;
      border-radius: 30px;
      font-size: 13px;
    }

    /* LOGOUT */
    .logout-btn {
      background: #dc3545;
      color: white;
      padding: 6px 14px;
      border-radius: 30px;
      text-decoration: none;
      font-size: 13px;
    }

    .logout-btn:hover {
      background: #bb2d3b;
    }
  </style>
</head>

<body>

<!-- PREMIUM NAVBAR -->
<div class="premium-nav">
  <div class="nav-container">

    <!-- Logo -->
    <div class="nav-logo">
      ⌘ CodeVault
    </div>

    <!-- Your Links -->
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/code/dashboard">Dashboard</a>
      <a href="/code/add">Add Code</a>
    </div>

    <!-- Right Side -->
    <div class="nav-right">

      <% if (!user) { %>
        <a href="/login" class="nav-btn">Login</a>
      <% } else { %>
        <span class="nav-user"><%= user.email %></span>
        <a href="/logout" class="logout-btn">Logout</a>
      <% } %>

    </div>

  </div>
</div>
